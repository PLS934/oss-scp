{
  "name": "oss-scp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @oss-scp/api dev",
    "start": "pnpm --filter @oss-scp/api start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:process": "node scripts/test-process.mjs",
    "test:docker": "bash scripts/test-docker.sh",
    "dev:web": "pnpm --filter @oss-scp/web dev",
    "test:browser": "node scripts/test-browser.mjs",
    "test:docker:web": "node scripts/test-web-docker.mjs",
    "dev:mock": "pnpm --filter @oss-scp/mock-api dev",
    "start:mock": "pnpm --filter @oss-scp/mock-api start",
    "test:docker:mock": "node scripts/test-mock-docker.mjs",
    "test:process:mock": "node scripts/test-mock-process.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "typescript-eslint": "8.70.0",
    "@playwright/test": "1.63.0"
  }
}
