# API와 웹에 함께 적용할 제품 버전입니다.
OSS_SCP_VERSION=0.1.0
# 운영자 플러그인·Connection 설정 checkout의 절대 경로입니다.
# API 컨테이너 UID 1000이 디렉터리를 탐색하고 파일을 읽을 수 있어야 합니다.
OSS_SCP_CONFIG_PATH=/absolute/path/to/oss-scp-plugin-config
API_PORT=3000
WEB_PORT=8080
PLATFORM_DB_NAME=oss_scp
PLATFORM_DB_USER=oss_scp_app
# 실제 값은 이 파일에 저장하지 말고 실행 환경 또는 별도 secret override로 제공합니다.
PLATFORM_DB_PASSWORD=
