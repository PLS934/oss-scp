{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oss-scp.dev/schemas/source-v1.json",
  "title": "oss-scp source",
  "oneOf": [
    { "$ref": "#/$defs/jsonSource" },
    { "$ref": "#/$defs/localCsvSource" },
    { "$ref": "#/$defs/httpCsvSource" }
    ,{ "$ref": "#/$defs/postgresSource" }
  ],
  "$defs": {
    "jsonSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "connectionRef", "path", "method", "format", "itemsPath", "limits", "pagination"],
      "properties": {
        "apiVersion": { "const": "oss-scp/source-v1" },
        "connectionRef": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 100 },
        "path": { "type": "string", "pattern": "^/(?!/)[^?#\\u0000]*$", "maxLength": 2048 },
        "method": { "const": "GET" },
        "format": { "const": "json" },
        "itemsPath": { "$ref": "#/$defs/jsonPath" },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timeoutMs", "maxResponseBytes", "maxRecordBytes"],
          "properties": {
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 300000 },
            "maxResponseBytes": { "type": "integer", "minimum": 1024, "maximum": 104857600 },
            "maxRecordBytes": { "type": "integer", "minimum": 1, "maximum": 104857600 }
          }
        },
        "metadataPaths": { "type": "array", "uniqueItems": true, "maxItems": 20, "items": { "$ref": "#/$defs/jsonPath" } },
        "pagination": {
          "oneOf": [
            { "$ref": "https://oss-scp.dev/schemas/source-offset-v1.json" },
            { "$ref": "https://oss-scp.dev/schemas/source-single-v1.json" }
          ]
        }
      }
    },
    "localCsvSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "transport", "format", "path", "batchSize"],
      "properties": {
        "apiVersion": { "const": "oss-scp/source-v1" },
        "transport": { "const": "file" },
        "format": { "const": "csv" },
        "path": { "type": "string", "pattern": "^(?!/)[^\\u0000]+\\.csv$", "maxLength": 4096 },
        "batchSize": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxRecordSize": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "httpCsvSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "transport", "connectionRef", "path", "method", "format", "batchSize", "limits"],
      "properties": {
        "apiVersion": { "const": "oss-scp/source-v1" },
        "transport": { "const": "http" },
        "connectionRef": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 100 },
        "path": { "type": "string", "pattern": "^/(?!/)[^?#\\u0000]*$", "maxLength": 2048 },
        "method": { "const": "GET" },
        "format": { "const": "csv" },
        "batchSize": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timeoutMs", "maxDownloadBytes", "maxCsvBytes", "maxRecordSize"],
          "properties": {
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 300000 },
            "maxDownloadBytes": { "type": "integer", "minimum": 1, "maximum": 104857600 },
            "maxCsvBytes": { "type": "integer", "minimum": 1, "maximum": 104857600 },
            "maxRecordSize": { "type": "integer", "minimum": 1, "maximum": 104857600 }
          }
        }
      }
    },
    "postgresSource": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "type", "persistence", "connectionRef", "listQuery", "detailQuery", "externalKeyColumn", "queryFields", "batchSize", "limits"],
      "properties": {
        "apiVersion": { "const": "oss-scp/source-v1" },
        "type": { "const": "db-postgres" },
        "persistence": { "const": "none" },
        "connectionRef": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 100 },
        "listQuery": { "type": "string", "minLength": 1, "maxLength": 100000 },
        "detailQuery": { "type": "string", "minLength": 1, "maxLength": 100000 },
        "externalKeyColumn": { "$ref": "#/$defs/sqlIdentifier" },
        "queryFields": { "type": "object", "minProperties": 1, "maxProperties": 100, "additionalProperties": { "$ref": "#/$defs/queryField" } },
        "batchSize": { "type": "integer", "minimum": 1, "maximum": 500 },
        "limits": { "type": "object", "additionalProperties": false, "required": ["rowCap", "timeoutMs", "maxResponseBytes"], "properties": {
          "rowCap": { "type": "integer", "minimum": 1, "maximum": 500 },
          "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 5000 },
          "maxResponseBytes": { "type": "integer", "minimum": 1024, "maximum": 16777216 }
        } },
        "cache": { "type": "object", "additionalProperties": false, "required": ["kind", "ttlSeconds"], "properties": { "kind": { "const": "watchlist" }, "ttlSeconds": { "const": 600 } } }
      }
    },
    "queryField": {
      "type": "object", "additionalProperties": false, "required": ["column", "type"],
      "properties": { "column": { "$ref": "#/$defs/sqlIdentifier" }, "type": { "enum": ["string", "number", "boolean", "datetime"] } }
    },
    "sqlIdentifier": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$", "maxLength": 63 },
    "jsonPath": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*(?:\\.[A-Za-z_$][A-Za-z0-9_$-]*)*$",
      "maxLength": 255
    }
  }
}
