{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oss-scp.dev/schemas/source-v1.json",
  "title": "oss-scp source",
  "oneOf": [
    { "$ref": "#/$defs/jsonOffsetSource" },
    { "$ref": "#/$defs/localCsvSource" }
  ],
  "$defs": {
    "jsonOffsetSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "connectionRef", "path", "method", "format", "itemsPath", "pagination"],
      "properties": {
        "apiVersion": { "const": "oss-scp/source-v1" },
        "connectionRef": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 100 },
        "path": { "type": "string", "pattern": "^/(?!/)[^?#\\u0000]*$", "maxLength": 2048 },
        "method": { "const": "GET" },
        "format": { "const": "json" },
        "itemsPath": { "$ref": "#/$defs/jsonPath" },
        "pagination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "offsetParam", "limitParam", "start", "limit", "totalPath"],
          "properties": {
            "type": { "const": "offset" },
            "offsetParam": { "$ref": "#/$defs/parameterName" },
            "limitParam": { "$ref": "#/$defs/parameterName" },
            "start": { "type": "integer", "minimum": 0 },
            "limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "totalPath": { "$ref": "#/$defs/jsonPath" }
          }
        }
      }
    },
    "localCsvSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "transport", "format", "path", "batchSize"],
      "properties": {
        "apiVersion": { "const": "oss-scp/source-v1" },
        "transport": { "const": "file" },
        "format": { "const": "csv" },
        "path": { "type": "string", "pattern": "^(?!/)[^\\u0000]+\\.csv$", "maxLength": 4096 },
        "batchSize": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxRecordSize": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "jsonPath": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*(?:\\.[A-Za-z_$][A-Za-z0-9_$-]*)*$",
      "maxLength": 255
    },
    "parameterName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
      "maxLength": 100
    }
  }
}
