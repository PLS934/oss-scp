{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oss-scp.dev/schemas/plugin-registry.json",
  "title": "oss-scp plugin registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["plugins"],
  "properties": {
    "plugins": {
      "type": "array",
      "items": { "type": "string" }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "timezone": { "type": "string", "minLength": 1, "maxLength": 255 },
            "time": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" }
          }
        }
      }
    }
  }
}
