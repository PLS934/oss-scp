{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oss-scp.dev/schemas/plugin-v1.json",
  "title": "oss-scp plugin",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "id", "name", "version", "source", "transform", "data"],
  "properties": {
    "apiVersion": { "const": "oss-scp/plugin-v1" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "maxLength": 2000 },
    "enabled": { "type": "boolean", "default": true },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "source": {
      "type": "string",
      "pattern": "^\\./[^\\u0000]+\\.json$",
      "maxLength": 255
    },
    "transform": {
      "type": "string",
      "pattern": "^\\./[^\\u0000]+\\.js$",
      "maxLength": 255
    },
    "menu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "icon", "group", "order", "path", "dataType"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "icon": { "enum": ["server", "shield", "repository"] },
        "group": { "type": "string", "minLength": 1, "maxLength": 100 },
        "order": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "path": { "type": "string", "pattern": "^/(?:[a-z][a-z0-9-]*)(?:/[a-z][a-z0-9-]*)*$", "maxLength": 255 },
        "dataType": { "$ref": "#/$defs/id" }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["types"],
      "properties": {
        "types": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/dataType" }
        },
        "relations": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/relation" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 100 },
    "field": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "label"], "properties": { "type": { "enum": ["string", "number", "boolean", "datetime"] }, "label": { "$ref": "#/$defs/label" }, "required": { "type": "boolean", "default": false }, "searchable": { "const": true }, "sortable": { "const": true }, "filter": { "$ref": "#/$defs/filter" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "label", "fields"], "properties": { "type": { "const": "object" }, "label": { "$ref": "#/$defs/label" }, "required": { "type": "boolean", "default": false }, "fields": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/field" } } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "label", "items"], "properties": { "type": { "const": "array" }, "label": { "$ref": "#/$defs/label" }, "required": { "type": "boolean", "default": false }, "items": { "$ref": "#/$defs/field" } } }
      ]
    },
    "filter": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["kind", "options"], "properties": {"kind": {"enum": ["select", "multiSelect"]}, "options": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["value", "label"], "properties": {"value": {"anyOf": [{"type": "string"}, {"type": "number"}, {"type": "boolean"}]}, "label": {"$ref": "#/$defs/label"}}}}}}, {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"enum": ["numberRange", "dateRange"]}}}]},
    "label": { "type": "string", "minLength": 1, "maxLength": 100 },
    "dataType": { "type": "object", "additionalProperties": false, "required": ["uniqueKey", "fields", "views"], "properties": { "uniqueKey": { "type": "string", "minLength": 1, "maxLength": 100 }, "fields": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/field" } }, "views": { "$ref": "#/$defs/views" } } },
    "views": { "type": "object", "additionalProperties": false, "required": ["list", "detail"], "properties": { "list": { "$ref": "#/$defs/listView" }, "detail": { "$ref": "#/$defs/detailView" } } },
    "listView": { "type": "object", "additionalProperties": false, "required": ["columns"], "properties": { "columns": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } } } },
    "detailView": { "type": "object", "additionalProperties": false, "required": ["sections"], "properties": { "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/detailSection" } } } },
    "detailSection": { "type": "object", "additionalProperties": false, "required": ["title", "fields"], "properties": { "title": { "$ref": "#/$defs/label" }, "fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } } } },
    "relationEnd": { "type": "object", "additionalProperties": false, "required": ["types"], "properties": { "types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } } },
    "relation": { "type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": { "from": { "$ref": "#/$defs/relationEnd" }, "to": { "$ref": "#/$defs/relationEnd" } } }
  }
}
