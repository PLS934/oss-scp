{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oss-scp.dev/schemas/plugin-v1.json",
  "title": "oss-scp plugin",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "id", "name", "version", "source", "transform", "data"],
  "properties": {
    "apiVersion": { "const": "oss-scp/plugin-v1" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "source": {
      "type": "string",
      "pattern": "^\\./[^\\u0000]+\\.json$",
      "maxLength": 255
    },
    "transform": {
      "type": "string",
      "pattern": "^\\./[^\\u0000]+\\.js$",
      "maxLength": 255
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["types"],
      "properties": {
        "types": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/dataType" }
        },
        "relations": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/relation" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 100 },
    "field": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "enum": ["string", "number", "boolean", "datetime"] }, "required": { "type": "boolean", "default": false } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "fields"], "properties": { "type": { "const": "object" }, "required": { "type": "boolean", "default": false }, "fields": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/field" } } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "items"], "properties": { "type": { "const": "array" }, "required": { "type": "boolean", "default": false }, "items": { "$ref": "#/$defs/field" } } }
      ]
    },
    "dataType": { "type": "object", "additionalProperties": false, "required": ["uniqueKey", "fields"], "properties": { "uniqueKey": { "type": "string", "minLength": 1, "maxLength": 100 }, "fields": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/field" } } } },
    "relationEnd": { "type": "object", "additionalProperties": false, "required": ["types"], "properties": { "types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } } },
    "relation": { "type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": { "from": { "$ref": "#/$defs/relationEnd" }, "to": { "$ref": "#/$defs/relationEnd" } } }
  }
}
