{
  "name": "@oss-scp/api",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "healthcheck.mjs"
  ],
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "pnpm --filter @oss-scp/platform-db build && pnpm --filter @oss-scp/plugin-config build && pnpm --filter @oss-scp/collector-cli build",
    "build": "nest build",
    "start": "node dist/main.js",
    "pretypecheck": "pnpm --filter @oss-scp/platform-db build && pnpm --filter @oss-scp/plugin-config build && pnpm --filter @oss-scp/collector-cli build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@oss-scp/collector-cli": "workspace:*",
    "@oss-scp/platform-db": "workspace:*",
    "@oss-scp/plugin-config": "workspace:*",
    "ldapts": "^9.2.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.3",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "testcontainers": "12.1.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
