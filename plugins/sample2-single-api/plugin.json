{
  "apiVersion": "oss-scp/plugin-v1",
  "id": "sample2-single-api",
  "name": "Sample 2 Single API",
  "version": "0.1.0",
  "source": "./source.json",
  "transform": "./dist/transform.js",
  "menu": { "title": "저장소", "icon": "repository", "group": "자산 관리", "order": 20, "path": "/assets/repositories", "dataType": "repository" },
  "data": {
    "types": {
      "repository": {
        "uniqueKey": "assetKey",
        "views": {
          "list": { "columns": ["fullName", "active", "feed"] },
          "detail": { "sections": [
            { "title": "저장소 정보", "fields": ["assetKey", "fullName", "active", "feed"] },
            { "title": "상세 구성", "fields": ["details", "members"] }
          ] }
        },
        "fields": {
          "assetKey": { "type": "string", "label": "자산 키", "required": true },
          "fullName": { "type": "string", "label": "저장소 전체 이름", "required": true },
          "active": { "type": "boolean", "label": "활성 상태", "required": true },
          "details": { "type": "object", "label": "상세 정보", "required": true, "fields": { "label": { "type": "string", "label": "표시명", "required": true }, "observedAt": { "type": "datetime", "label": "관측 시각", "required": true } } },
          "members": { "type": "array", "label": "구성원", "required": true, "items": { "type": "object", "label": "구성원", "fields": { "login": { "type": "string", "label": "로그인", "required": true } } } },
          "feed": { "type": "string", "label": "피드", "required": true }
        }
      }
    }
  }
}
