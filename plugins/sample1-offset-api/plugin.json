{
  "apiVersion": "oss-scp/plugin-v1",
  "id": "sample1-offset-api",
  "name": "Sample 1 Offset API",
  "version": "0.1.0",
  "source": "./source.json",
  "transform": "./dist/transform.js",
  "menu": { "title": "서버 자산", "icon": "server", "group": "자산 관리", "order": 10, "path": "/assets/servers", "dataType": "asset" },
  "data": {
    "types": {
      "asset": {
        "uniqueKey": "hostname",
        "views": {
          "list": { "columns": ["hostname", "environment", "ip", "enabled"] },
          "detail": { "sections": [
            { "title": "기본 정보", "fields": ["hostname", "environment", "ip"] },
            { "title": "수집 정보", "fields": ["integerValue", "decimalValue", "enabled"] }
          ] }
        },
        "fields": {
          "hostname": {"type": "string", "label": "호스트명", "required": true, "searchable": true, "sortable": true},
          "environment": {"type": "string", "label": "환경", "required": true, "searchable": true, "sortable": true, "filter": {"kind": "multiSelect", "options": [{"value": "sandbox", "label": "sandbox"}]}},
          "ip": {"type": "string", "label": "IP 주소", "required": true, "searchable": true, "sortable": true},
          "integerValue": { "type": "number", "label": "정수 값", "required": true },
          "decimalValue": { "type": "number", "label": "소수 값", "required": true },
          "enabled": {"type": "boolean", "label": "활성 상태", "required": true, "sortable": true, "filter": {"kind": "select", "options": [{"value": true, "label": "활성"}, {"value": false, "label": "비활성"}]}}
        }
      }
    }
  }
}
