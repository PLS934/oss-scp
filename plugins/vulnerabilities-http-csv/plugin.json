{
  "apiVersion": "oss-scp/plugin-v1",
  "id": "vulnerabilities-http-csv",
  "name": "Vulnerabilities HTTP CSV",
  "version": "0.1.0",
  "source": "./source.json",
  "transform": "./dist/transform.js",
  "menu": { "title": "HTTP 취약점", "icon": "shield", "group": "보안 관리", "order": 20, "path": "/vulnerabilities/http", "dataType": "vulnerability" },
  "data": {
    "types": {
      "vulnerability": {
        "uniqueKey": "cve",
        "views": {
          "list": { "columns": ["cve", "name", "score", "affected", "observedAt"] },
          "detail": { "sections": [
            { "title": "식별 정보", "fields": ["cve", "name"] },
            { "title": "HTTP 수집 결과", "fields": ["score", "affected", "observedAt"] }
          ] }
        },
        "fields": {
          "cve": {"type": "string", "label": "CVE", "required": true, "searchable": true, "sortable": true},
          "name": {"type": "string", "label": "취약점명", "required": true, "searchable": true, "sortable": true},
          "score": {"type": "number", "label": "점수", "required": true, "sortable": true, "filter": {"kind": "numberRange"}},
          "affected": {"type": "boolean", "label": "영향 여부", "required": true, "sortable": true, "filter": {"kind": "select", "options": [{"value": true, "label": "영향 있음"}, {"value": false, "label": "영향 없음"}]}},
          "observedAt": {"type": "datetime", "label": "관측 시각", "required": true, "sortable": true, "filter": {"kind": "dateRange"}}
        }
      }
    }
  }
}
