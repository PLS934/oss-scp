# 로컬 서버 설정. 파일 없이도 아래 기본값으로 실행됩니다.
HOST=127.0.0.1
PORT=3000
# Docker Compose의 호스트 포트. 컨테이너 내부는 3000입니다.
API_PORT=3000
# 배포 웹은 다른 컴퓨터에도 공개하며, 개발 Compose는 localhost에만 공개합니다.
WEB_PORT=8080
# 배포 Nginx의 컨테이너 네트워크 내 API 주소
API_UPSTREAM=api:3000
# 로컬 Vite 프록시. Docker 개발에서는 api:3000으로 설정됩니다.
API_PROXY_TARGET=http://127.0.0.1:3000
# Docker에서 파일 변경 감지가 되지 않을 때만 사용합니다.
WATCH_POLLING=false
TSC_WATCHFILE=UseFsEvents

# 운영자 Git revision의 플러그인·Connection 설정 루트입니다.
OSS_SCP_CONFIG_ROOT=.
# Compose에는 반드시 절대 호스트 경로를 지정하고 /config:ro로 주입합니다.
# API 컨테이너 UID 1000이 경로를 탐색하고 설정 파일을 읽을 수 있어야 합니다.
OSS_SCP_CONFIG_PATH=/absolute/path/to/oss-scp-plugin-config

# 플랫폼 운영 DB. 기본 Compose는 PostgreSQL을 내부 네트워크에서 함께 실행합니다.
PLATFORM_DB_TYPE=postgres
PLATFORM_DB_HOST=localhost
PLATFORM_DB_PORT=5432
PLATFORM_DB_NAME=oss_scp
PLATFORM_DB_USER=oss_scp_app
# 아래 두 방식 중 하나만 설정합니다. 비밀번호는 실행 환경에서 제공하세요.
PLATFORM_DB_PASSWORD=replace-with-a-random-local-password
# PLATFORM_DB_PASSWORD_FILE=/run/secrets/platform_db_password
# 로컬 평문 DB 예시. 운영 TLS 기본값은 verify-full입니다.
PLATFORM_DB_TLS_MODE=disable
# PLATFORM_DB_TLS_CA_FILE=/run/secrets/platform_db_ca.pem
# PLATFORM_DB_POOL_MAX=10
# PLATFORM_DB_CONNECT_TIMEOUT_MS=5000

# MySQL 내장 Compose용 초기화 계정. application 비밀번호와 다르게 설정하세요.
# MYSQL_ROOT_PASSWORD=replace-with-a-separate-random-root-password

# 선택적 LDAP/AD 로그인. 기본 compose는 AUTH_ENABLED=false를 사용합니다.
# 활성화할 때 compose.auth.example.yaml overlay와 아래 값을 설정합니다.
# LDAP_URL=ldaps://ldap.example.com:636
# LDAP_URL=ldap://ldap.example.com:389  # 이 형식도 Bind 전에 StartTLS를 강제합니다.
# LDAP_BIND_DN=cn=service,ou=system,dc=example,dc=com
# LDAP_USER_SEARCH_BASE_DN=ou=users,dc=example,dc=com
# LDAP_USER_SEARCH_FILTER=(uid={{login}})
# LDAP_USER_ID_ATTRIBUTE=entryUUID
# LDAP_BIND_PASSWORD_PATH=/absolute/path/to/ldap-bind-password
# AUTH_SESSION_SECRET_PATH=/absolute/path/to/auth-session-secret
# AUTH_SESSION_TTL_SECONDS=28800
# OS가 신뢰하지 않는 사내 CA를 쓸 때 compose.auth-ca.example.yaml도 적용합니다.
# LDAP_TLS_CA_PATH=/absolute/path/to/ldap-ca.pem
